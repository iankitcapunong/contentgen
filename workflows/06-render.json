      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-840, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "supabase_url",
              "value": "https://vhhugcnlwriixzdpjrli.supabase.co",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "shotstack_env",
              "value": "stage",
              "type": "string"
