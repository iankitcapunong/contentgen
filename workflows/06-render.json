              "name": "background",
              "value": "#000000",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "show_captions",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "cg06-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-620, 300],
      "notes": "shotstack_env: 'stage' is the sandbox (free, for building) and 'v1' is production. Check Shotstack's current sandbox terms re: watermarking before you publish anything rendered on stage."
    },
    {
