# -----------------------------------------------------------------------------
# Reference list of every secret this pipeline needs.
#
# n8n stores these in its own encrypted credential store, NOT in a .env file —
# see docs/credentials.md. This file exists so you can gather everything in one
# pass before you start, and so self-hosted n8n users can wire the non-secret
# values through $env instead of editing eight Config nodes.
#
# Copy to .env only if you are self-hosting. Never commit the filled-in copy.
# -----------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # bypasses RLS — n8n only, never a browser

# --- LLM (ideation + script) ------------------------------------------------
# https://openrouter.ai/keys — set a spend limit while building
OPENROUTER_API_KEY=                   # used as: Authorization: Bearer <key>

# --- Voiceover --------------------------------------------------------------
ELEVENLABS_API_KEY=                   # used as: xi-api-key: <key>
ELEVENLABS_VOICE_ID=                  # last segment of the voice's URL

# --- Images + video ---------------------------------------------------------
# https://fal.ai/dashboard/keys — one key covers FLUX and the video models
FAL_KEY=                              # used as: Authorization: Key <key>

# --- Render -----------------------------------------------------------------
# Separate keys for stage and production — must match shotstack_env in wf 06
SHOTSTACK_API_KEY=                    # used as: x-api-key: <key>
SHOTSTACK_ENV=stage                   # 'stage' (sandbox) or 'v1' (production)

# --- Google (Drive + Sheets) ------------------------------------------------
# One Cloud project, OAuth2 client. Entered in n8n's credential UI, not here.
# PUBLISH the consent screen or refresh tokens expire after 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GDRIVE_PARENT_FOLDER_ID=              # last segment of the folder URL
GOOGLE_SHEET_ID=                      # last segment of the sheet URL
GOOGLE_SHEET_TAB=Videos

# --- Self-hosted n8n only ---------------------------------------------------
N8N_DEFAULT_BINARY_DATA_MODE=filesystem   # keeps large mp4s out of RAM
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_DATA_PRUNE=true
N8N_ENCRYPTION_KEY=                       # generate once, back it up — losing it
                                          # makes every stored credential unreadable
